# Production settings: configure in Netlify, never commit real credentials.
SNABB_STORAGE=netlify
SNABB_SITE_URL=https://snabb.studio
SNABB_IDENTITY_URL=https://snabb.studio/.netlify/identity
SNABB_ADMIN_EMAIL=your-email@example.com
# Optional isolated store name. Defaults to snabb-cms-${CONTEXT}.
# SNABB_STORE_NAME=snabb-cms-production

# Local only: set explicitly when running on localhost; ignored on Netlify.
# SNABB_LOCAL_CMS=1
# SNABB_DATA_DIR=.data
